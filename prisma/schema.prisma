datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model BirthdayWish {
  id         String   @id @default(uuid())
  slug       String   @unique
  senderName String
  friendName String
  message    String?
  photoData  String?
  createdAt  DateTime @default(now())

  @@index([slug])
  @@map("Prank")
}
